# Amdox AI Task Optimizer - Environment Configuration

# Application Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
LOG_LEVEL=INFO
PORT=5000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/amdox_task_optimizer
SQL_ECHO=False

# Redis Configuration (for caching and queues)
REDIS_URL=redis://localhost:6379/0

# Email Notification Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=noreply@amdox.com
SENDER_PASSWORD=your-email-password-here

# Alert Thresholds
STRESS_HIGH_THRESHOLD=0.7
STRESS_CRITICAL_THRESHOLD=0.85
BURNOUT_RISK_HIGH=high
BURNOUT_RISK_CRITICAL=critical

# Task Recommendation Settings
MIN_TASK_MATCH_SCORE=0.3
MAX_RECOMMENDATIONS=5

# ML Model Settings
MODEL_DEVICE=cpu
ENABLE_GPU=False

# Scheduler Settings
ENABLE_DAILY_ANALYSIS=True
DAILY_ANALYSIS_HOUR=9
DAILY_ANALYSIS_MINUTE=0

ENABLE_WEEKLY_REPORT=True
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_HOUR=10

ENABLE_HOURLY_MONITORING=True

# Security Settings
CORS_ORIGINS=*
API_KEY_REQUIRED=False

# Monitoring
PROMETHEUS_ENABLED=False
PROMETHEUS_PORT=9090

# Feature Flags
ENABLE_FACIAL_ANALYSIS=True
ENABLE_SPEECH_ANALYSIS=True
ENABLE_TEXT_ANALYSIS=True
ENABLE_EMAIL_NOTIFICATIONS=False
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Email Configuration (for HR alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-app-password

# Security
JWT_SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key

# ML Model Paths
EMOTION_MODEL_PATH=models/emotion_classifier.pkl
STRESS_MODEL_PATH=models/stress_detector.pkl
TASK_RECOMMENDER_PATH=models/task_recommender.pkl

# Monitoring
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO

# Privacy Settings
DATA_RETENTION_DAYS=90
ANONYMIZATION_ENABLED=True
CONSENT_REQUIRED=True