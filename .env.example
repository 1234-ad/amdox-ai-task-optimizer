# Environment Configuration
DEBUG=True
SECRET_KEY=your-secret-key-here

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/amdox_db
REDIS_URL=redis://localhost:6379/0

# API Keys
OPENAI_API_KEY=your-openai-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key

# Email Configuration (for HR alerts)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=your-email@company.com
EMAIL_PASSWORD=your-app-password

# Security
JWT_SECRET_KEY=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key

# ML Model Paths
EMOTION_MODEL_PATH=models/emotion_classifier.pkl
STRESS_MODEL_PATH=models/stress_detector.pkl
TASK_RECOMMENDER_PATH=models/task_recommender.pkl

# Monitoring
PROMETHEUS_PORT=8000
LOG_LEVEL=INFO

# Privacy Settings
DATA_RETENTION_DAYS=90
ANONYMIZATION_ENABLED=True
CONSENT_REQUIRED=True